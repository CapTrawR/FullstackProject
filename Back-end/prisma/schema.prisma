generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique
  password String
  codigo_postal String
  admin Boolean @default(false)

  cartItems CartItem[]
}

model Product{
  id String @id @default(uuid())
  name String
  description String
  price Decimal
  category String
  img String
  createdAt DateTime @default(now())

  cartItems CartItem[]
}

model CartItem{
  id String @id @default(uuid())
  userId String
  productId String
  quantity Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}
